{
  "name": "bot-platform-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "build": "npm run typecheck:app && npm run build:app",
    "build:app": "node ../miniapp/build.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit -p ../miniapp/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply bots-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bots-db --remote"
  },
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
